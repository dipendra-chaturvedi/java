<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FC">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:orientation="horizontal"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="andrul"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#6C4CF1" />

        <TextView
            android:id="@+id/searchButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="⌕"
            android:textSize="30sp"
            android:textColor="#25243A"
            android:background="#F2F0FF" />

        <TextView
            android:id="@+id/messagesButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:text="✉"
            android:textSize="22sp"
            android:textColor="#25243A"
            android:background="#F2F0FF" />
    </LinearLayout>

    <!-- Scrollable feed -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:text="Your community"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="#202033" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:text="Discover what everyone is sharing."
                android:textSize="14sp"
                android:textColor="#85859A" />

            <!-- Stories -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <LinearLayout
                        android:layout_width="76dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="5dp">

                        <TextView
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:gravity="center"
                            android:text="+"
                            android:textSize="30sp"
                            android:textColor="#6C4CF1"
                            android:background="#E9E3FF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Your story"
                            android:textSize="11sp"
                            android:textColor="#505066" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="76dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="5dp">

                        <TextView
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:gravity="center"
                            android:text="A"
                            android:textSize="23sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="#8B5CF6" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Ananya"
                            android:textSize="11sp"
                            android:textColor="#505066" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="76dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="5dp">

                        <TextView
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:gravity="center"
                            android:text="R"
                            android:textSize="23sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="#F97391" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Rahul"
                            android:textSize="11sp"
                            android:textColor="#505066" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="76dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="5dp">

                        <TextView
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:gravity="center"
                            android:text="P"
                            android:textSize="23sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="#14B8A6" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Priya"
                            android:textSize="11sp"
                            android:textColor="#505066" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="76dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="5dp">

                        <TextView
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:gravity="center"
                            android:text="K"
                            android:textSize="23sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="#F59E0B" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Karan"
                            android:textSize="11sp"
                            android:textColor="#505066" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Feed section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="22dp"
                android:text="Latest posts"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#202033" />

            <!-- Post card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="14dp"
                android:padding="16dp"
                android:orientation="vertical"
                android:background="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:gravity="center"
                        android:text="A"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="#8B5CF6" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ananya Sharma"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="#202033" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="20 min ago · Public"
                            android:textSize="12sp"
                            android:textColor="#9090A3" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="•••"
                        android:textSize="20sp"
                        android:textColor="#77778A" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="A little progress every day adds up to big results. Keep building, keep learning! ✨"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#414156" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="✦\nCREATE YOUR OWN PATH"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="10dp"
                    android:textColor="#FFFFFF"
                    android:background="#7660E8" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/likeButton"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="12dp"
                        android:text="♡  128"
                        android:textSize="14sp"
                        android:textColor="#E34B78" />

                    <TextView
                        android:id="@+id/commentButton"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="12dp"
                        android:text="○  24 comments"
                        android:textSize="14sp"
                        android:textColor="#77778A" />

                    <TextView
                        android:id="@+id/shareButton"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="↗"
                        android:textSize="20sp"
                        android:textColor="#77778A" />
                </LinearLayout>
            </LinearLayout>

            <!-- Second post -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="14dp"
                android:padding="16dp"
                android:orientation="vertical"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R Rahul Verma  ·  1 hour ago"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#202033" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Finally finished my new project! 🚀 What are you working on today?"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#414156" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="♡  56        ○  8 comments"
                    android:textSize="14sp"
                    android:textColor="#77778A" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂\nHome"
            android:textSize="12sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp"
            android:textColor="#6C4CF1" />

        <TextView
            android:id="@+id/navExplore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌕\nExplore"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:textColor="#85859A" />

        <TextView
            android:id="@+id/navCreate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="＋\nCreate"
            android:textSize="12sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp"
            android:textColor="#6C4CF1" />

        <TextView
            android:id="@+id/navNotifications"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♡\nAlerts"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:textColor="#85859A" />

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="●\nProfile"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:textColor="#85859A" />

    </LinearLayout>

</LinearLayout>
